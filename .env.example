# These are the DEFAULTS. Anything set in the app's Settings (menu > Settings) overrides them.

# --- Transcription ---------------------------------------------------------
# Provider: "local" (careless_whisper API, default) or "openai" (any OpenAI-compatible server)
VITE_TRANSCRIPTION_PROVIDER=local

# Base URL override (optional). Defaults per provider:
#   local  -> /whisper  (same-origin path; the Vite dev/preview server proxies it to
#                        http://localhost:8765, or WHISPER_PROXY_TARGET below)
#   openai -> https://api.openai.com/v1
# Use a relative path like /whisper if you open the app from a phone: "localhost" would
# be the phone itself, and an https page can't call an http LAN address.
VITE_TRANSCRIPTION_API_URL=/whisper

# Where the dev/preview server forwards /whisper/* (not bundled into the browser code)
WHISPER_PROXY_TARGET=http://localhost:8765

# Model (optional). Defaults: local -> base (tiny|base|small|medium|large|turbo), openai -> whisper-1
VITE_WHISPER_MODEL=base

# Bearer token (optional, only if your endpoint needs one).
# WARNING: VITE_* values are bundled into the client code; don't use a real secret on a shared host.
VITE_TRANSCRIPTION_API_KEY=

# --- Translate button ------------------------------------------------------
# Full URL called with POST {action:"translate", text, target_language, id, timestamp}
VITE_TRANSLATE_API_URL=
VITE_TRANSLATE_TARGET_LANGUAGE=English
VITE_TRANSLATE_API_KEY=

# --- Agent button ----------------------------------------------------------
# Full URL called with POST {action:"agent_instruction", text, id, timestamp}
VITE_AGENT_API_URL=
VITE_AGENT_API_KEY=
